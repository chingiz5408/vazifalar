# ==========================================================================
# systemd — Sputnik Academy kod bajaruvchi servis (code_runner/queue_server.py)
# Joy: /etc/systemd/system/sputnik-queue.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sputnik-queue
#   sudo systemctl status sputnik-queue
#   journalctl -u sputnik-queue -f
#
# MUHIM:
#   1) usermod -aG docker admin   (docker guruhiga qo'shish)
#   2) Docker image qurilgan bo'lishi kerak:
#      docker build -t sputnik-python:3.12 /home/admin/loyha/code_runner
# ==========================================================================

[Unit]
Description=Sputnik Academy — kod bajaruvchi servis (queue_server)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=admin
Group=admin
# pool.py dagi "from pool import ..." importlari uchun shu papka
# ish katalogi bo'lishi shart — aks holda xato beradi.
WorkingDirectory=/home/admin/loyha/code_runner
Environment=PYTHONUNBUFFERED=1
# docker.sock ga kirish uchun qo'shimcha guruh
SupplementaryGroups=docker
ExecStart=/home/admin/loyha/venv/bin/python -u queue_server.py
Restart=always
RestartSec=5

# --- Xavfsizlik ---
# NoNewPrivileges YOQILMAYDI: Docker CLI konteyner boshqarishi uchun
# imtiyozlar kerak.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
