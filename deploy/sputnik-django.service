# ==========================================================================
# systemd — Sputnik Academy (Django + Gunicorn)
# Joy: /etc/systemd/system/sputnik-django.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sputnik-django
#   sudo systemctl status sputnik-django
#   journalctl -u sputnik-django -f
#
# Eslatma: User/yo'llar shu server uchun (/home/admin/loyha).
# Boshqa foydalanuvchi yoki yo'l ishlatsangiz — o'zgartiring.
# ==========================================================================

[Unit]
Description=Sputnik Academy — Django (gunicorn)
After=network.target

[Service]
Type=notify
User=admin
Group=admin
WorkingDirectory=/home/admin/loyha
# .env faylidan SECRET_KEY, DEBUG, ALLOWED_HOSTS, SECURE_SSL o'qiladi
EnvironmentFile=/home/admin/loyha/.env
ExecStart=/home/admin/loyha/venv/bin/gunicorn --config gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=30

# --- Xavfsizlik cheklovlari ---
# Loyiha /home/admin ichida joylashgani uchun ProtectHome YOQILMAYDI
# (aks holda kod, .env va baza o'qilmaydi).
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
