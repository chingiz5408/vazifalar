# ==========================================================================
# Sputnik Academy — .env namunasi
# Ishlatish:  cp .env.example .env   keyin qiymatlarni o'zgartiring
# ==========================================================================

# --- rejim ---
# Ishlab chiqish (lokal): true
# Production (serverda):  false
DEBUG=false

# --- xavfsizlik ---
# Yangi klavish yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Eslatma: kalitni HAR DOIM qo'shtirnoq ichida yozing — maxsus belgilar
# ( ! @ # $ % ^ & * ) systemd tomonida noto'g'ri o'qilishi mumkin.
SECRET_KEY=""

# Vergul bilan ajratilgan aniq domenlar (production'da "*" taqiqlanadi)
ALLOWED_HOSTS=sputnik.uz,www.sputnik.uz

# --- SSL (https://) ---
# Avval nginx + certbot bilan SSL o'rnating, keyin true qiling.
# true = https redirect + xavfsiz cookie + HSTS
SECURE_SSL=false
# HSTS jadvali (soniya). SSL ishlagandan keyin: 604800 = 7 kun
SECURE_HSTS_SECONDS=604800

# --- vaqt mintaqasi ---
TIME_ZONE=Asia/Tashkent

# --- kod bajaruvchi servis (code_runner) ---
CODE_RUNNER_BASE_URL=http://127.0.0.1:8765

# --- jurnal darajasi (server loglari) ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
