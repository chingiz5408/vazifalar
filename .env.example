# ==========================================================================
# Sputnik Academy — .env namunasi
# Ishlatish:  cp .env.example .env   keyin qiymatlarni o'zgartiring
# ==========================================================================

# --- rejim ---
# Ishlab chiqish (lokal): true
# Production (serverda):  false
DEBUG=false

# --- xavfsizlik ---
# Yangi klavish yaratish (TAVSIYA ETILADI — faqat xavfsiz belgilar):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# NIMA UCHUN shu usul: systemd EnvironmentFile da $ va % belgilarini
# kengaytirib yuboradi (masalan "$ht3f" bo'sh satr, "%%" -> "%" bo'ladi).
# Shuning uchun kalitda FAQAT harf, raqam, "-" va "_" bo'lishi kerak.
# Django'ning get_random_secret_key() funksiyasi esa !@#$%^&* beradi —
# serverda ishlatmang!
SECRET_KEY=""

# Vergul bilan ajratilgan aniq domenlar (production'da "*" taqiqlanadi).
# Domen yo'q bo'lsa — serverning IP manzilini yozing. Masalan:
#   ALLOWED_HOSTS=185.139.138.150
# Domen olgandan keyin:
#   ALLOWED_HOSTS=sputnik.uz,www.sputnik.uz
ALLOWED_HOSTS=185.139.138.150

# --- SSL (https://) ---
# Avval nginx + certbot bilan SSL o'rnating, keyin true qiling.
# true = https redirect + xavfsiz cookie + HSTS
SECURE_SSL=false
# HSTS jadvali (soniya). SSL ishlagandan keyin: 604800 = 7 kun
SECURE_HSTS_SECONDS=604800

# --- vaqt mintaqasi ---
TIME_ZONE=Asia/Tashkent

# --- kod bajaruvchi servis (code_runner) ---
CODE_RUNNER_BASE_URL=http://127.0.0.1:8765

# --- jurnal darajasi (server loglari) ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
